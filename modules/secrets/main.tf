locals {
  # Every secret this module can manage. "enabled" decides whether the logical
  # secret exists at all; "rotates" whether var.secret_version applies to it.
  # The map keys are stable: they are the for_each keys (state addresses).
  catalog = {
    secret_key = {
      description = "OPENARTIFACT_SECRET_KEY: AES-256-GCM key that seals signing keys and credentials stored by OpenArtifact. DO NOT ROTATE OR DELETE: previously stored secrets become unreadable."
      env_name    = "OPENARTIFACT_SECRET_KEY"
      path        = "secret-key"
      prefix      = ""
      enabled     = true
      rotates     = false
    }
    hmac_key = {
      description = "AUTH_HMAC_KEY: signs session and SSO state. Rotating it logs every user out."
      env_name    = "AUTH_HMAC_KEY"
      path        = "hmac-key"
      prefix      = ""
      enabled     = true
      rotates     = true
    }
    metrics_token = {
      description = "METRICS_AUTH_TOKEN: bearer token protecting /metrics."
      env_name    = "METRICS_AUTH_TOKEN"
      path        = "metrics-token"
      prefix      = ""
      enabled     = var.metrics_token_enabled
      rotates     = true
    }
    bootstrap_admin_password = {
      description = "OPENARTIFACT_BOOTSTRAP_ADMIN_PASSWORD: initial admin password."
      env_name    = "OPENARTIFACT_BOOTSTRAP_ADMIN_PASSWORD"
      path        = "bootstrap-admin-password"
      prefix      = ""
      enabled     = var.bootstrap_admin_password_enabled
      rotates     = true
    }
    bootstrap_admin_token = {
      description = "Initial admin API token (read by the server from OPENARTIFACT_BOOTSTRAP_ADMIN_TOKEN_FILE)."
      env_name    = "OPENARTIFACT_BOOTSTRAP_ADMIN_TOKEN"
      path        = "bootstrap-admin-token"
      prefix      = "oa_pat_"
      enabled     = var.bootstrap_admin_token_enabled
      rotates     = true
    }
  }

  enabled = { for k, v in local.catalog : k => v if v.enabled }

  # Only the secrets without a bring-your-own ARN are created and generated.
  generated = {
    for k, v in local.enabled : k => v
    if lookup(var.existing_secret_arns, k, null) == null
  }

  # ARN per enabled logical secret: bring-your-own wins, else the created one.
  arns = {
    for k, v in local.enabled : k => coalesce(
      lookup(var.existing_secret_arns, k, null),
      try(aws_secretsmanager_secret.generated[k].arn, null),
    )
  }
}

resource "aws_secretsmanager_secret" "generated" {
  #checkov:skip=CKV2_AWS_57: the values are generated once and are deliberately not auto-rotated; see the README for the rotation procedure and its consequences
  for_each = local.generated

  name                    = "${var.name}/${each.value.path}"
  description             = each.value.description
  kms_key_id              = var.kms_key_arn
  recovery_window_in_days = var.recovery_window_in_days

  tags = merge(var.tags, { Name = "${var.name}/${each.value.path}" })
}

# The values are generated by an ephemeral resource and handed to a
# write-only argument: they exist only in memory during the run and are never
# written to the plan or the state.
ephemeral "random_password" "generated" {
  for_each = local.generated

  length  = 64
  special = false
}

resource "aws_secretsmanager_secret_version" "generated" {
  for_each = local.generated

  secret_id                = aws_secretsmanager_secret.generated[each.key].id
  secret_string_wo         = "${each.value.prefix}${ephemeral.random_password.generated[each.key].result}"
  secret_string_wo_version = each.value.rotates ? var.secret_version : 1
}
