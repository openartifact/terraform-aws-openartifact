# Kubernetes-side delivery of the application secrets. The values live in AWS Secrets Manager
# (generated by modules/secrets with ephemeral resources, and the RDS-managed database
# secret); only one of the two blocks below is active, selected by var.secret_delivery:
#   external_secrets      -> ExternalSecret objects; the External Secrets Operator does the sync
#   terraform_write_only  -> Kubernetes Secrets written with write-only arguments
#   existing              -> nothing is created here; the caller owns the Kubernetes Secrets

locals {
  secret_labels = {
    "app.kubernetes.io/managed-by" = "terraform"
    "app.kubernetes.io/part-of"    = "openartifact"
  }
}

# ---------------------------------------------------------------------------
# external_secrets
# ---------------------------------------------------------------------------

# kubernetes_manifest needs the ExternalSecret CRD, i.e. a reachable cluster with the External
# Secrets Operator installed, already at plan time.
resource "kubernetes_manifest" "external_secret" {
  for_each = local.external_secret_specs

  manifest = {
    apiVersion = "external-secrets.io/v1"
    kind       = "ExternalSecret"
    metadata = {
      name      = each.value.target
      namespace = var.namespace
      labels    = local.secret_labels
    }
    spec = {
      refreshInterval = var.refresh_interval
      secretStoreRef = {
        name = var.secret_store_name
        kind = var.secret_store_kind
      }
      target = {
        name           = each.value.target
        creationPolicy = "Owner"
        deletionPolicy = "Retain"
      }
      data = [
        for secret_key, ref in each.value.data : {
          secretKey = secret_key
          remoteRef = merge(
            { key = ref.key },
            ref.property == "" ? {} : { property = ref.property },
          )
        }
      ]
    }
  }

  depends_on = [kubernetes_namespace_v1.this]
}

# ---------------------------------------------------------------------------
# terraform_write_only
# ---------------------------------------------------------------------------

# The values are read at apply time only. Ephemeral resources never reach plan or state, and
# data_wo is a write-only argument, so no secret is persisted by Terraform. depends_on makes the
# read wait for the secret versions (written by modules/secrets) and for the database.
ephemeral "aws_secretsmanager_secret_version" "source" {
  for_each = local.write_only_source_arns

  secret_id = each.value

  depends_on = [module.secrets, module.database]
}

resource "kubernetes_secret_v1" "app" {
  count = local.write_only ? 1 : 0

  metadata {
    name      = local.app_secret_name
    namespace = var.namespace
    labels    = local.secret_labels
  }

  type = "Opaque"
  data_wo = {
    for secret_key, logical in local.app_secret_sources :
    secret_key => ephemeral.aws_secretsmanager_secret_version.source[logical].secret_string
  }
  data_wo_revision = var.secret_data_revision

  depends_on = [kubernetes_namespace_v1.this]
}

resource "kubernetes_secret_v1" "database" {
  count = local.write_only ? 1 : 0

  metadata {
    name      = local.db_secret_name
    namespace = var.namespace
    labels    = local.secret_labels
  }

  type = "Opaque"
  # The RDS-managed secret is JSON {username, password}.
  data_wo = {
    (local.db_password_key) = jsondecode(ephemeral.aws_secretsmanager_secret_version.source["db_password"].secret_string)["password"]
  }
  data_wo_revision = var.secret_data_revision

  depends_on = [kubernetes_namespace_v1.this]
}

resource "kubernetes_secret_v1" "bootstrap" {
  count = local.write_only && var.bootstrap_admin_password_enabled ? 1 : 0

  metadata {
    name      = local.bootstrap_secret_name
    namespace = var.namespace
    labels    = local.secret_labels
  }

  type = "Opaque"
  data_wo = {
    for secret_key, logical in local.bootstrap_secret_sources :
    secret_key => ephemeral.aws_secretsmanager_secret_version.source[logical].secret_string
  }
  data_wo_revision = var.secret_data_revision

  depends_on = [kubernetes_namespace_v1.this]
}
